<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Jellyfin.Plugin.Oscars</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Oscars</RootNamespace>
    <Description>Jellyfin server plugin scaffold for Oscar metadata enrichment.</Description>
    <Version>1.0.6.0</Version>
    <AssemblyVersion>1.0.6.0</AssemblyVersion>
    <FileVersion>1.0.6.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The official Jellyfin plugin template documentation currently shows Jellyfin.Controller
      and Jellyfin.Model package references with ExcludeAssets=runtime.

      This version should match the target Jellyfin server version to avoid the plugin being
      marked NotSupported. It is intentionally kept explicit so it is easy to verify/change.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>logo.png</TargetPath>
    </None>
    <None Update="Resources\*.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>Resources\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**\.DS_Store" />
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="WritePluginMetaJson" AfterTargets="Publish">
    <ItemGroup>
      <PluginMetaJsonLines Include="{" />
      <PluginMetaJsonLines Include='  "category": "",' />
      <PluginMetaJsonLines Include='  "changelog": "",' />
      <PluginMetaJsonLines Include='  "description": "",' />
      <PluginMetaJsonLines Include='  "guid": "c531afa3-de20-4055-aca5-a7cc43adf783",' />
      <PluginMetaJsonLines Include='  "name": "Jellyfin Oscars",' />
      <PluginMetaJsonLines Include='  "overview": "",' />
      <PluginMetaJsonLines Include='  "owner": "",' />
      <PluginMetaJsonLines Include='  "targetAbi": "10.11.6.0",' />
      <PluginMetaJsonLines Include='  "timestamp": "0001-01-01T00:00:00.0000000Z",' />
      <PluginMetaJsonLines Include='  "version": "$(Version)",' />
      <PluginMetaJsonLines Include='  "status": "Active",' />
      <PluginMetaJsonLines Include='  "autoUpdate": false,' />
      <PluginMetaJsonLines Include='  "assemblies": [],' />
      <PluginMetaJsonLines Include='  "imageUrl": "logo.png"' />
      <PluginMetaJsonLines Include="}" />
    </ItemGroup>

    <WriteLinesToFile
      File="$(PublishDir)meta.json"
      Lines="@(PluginMetaJsonLines)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Jellyfin.Plugin.Oscars</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Oscars</RootNamespace>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0.0</Version>
    <Description>Jellyfin server plugin that enriches movie metadata with Oscar (Academy Awards) information.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The official Jellyfin plugin template documentation currently shows Jellyfin.Controller
      and Jellyfin.Model package references with ExcludeAssets=runtime.

      This version should match the target Jellyfin server version to avoid the plugin being
      marked NotSupported. It is intentionally kept explicit so it is easy to verify/change.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <None Update="meta.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>meta.json</TargetPath>
    </None>
    <None Update="Resources\logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>logo.png</TargetPath>
    </None>
    <None Update="Resources\winners.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>Resources\winners.png</TargetPath>
    </None>
    <None Update="Resources\nominated.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>Resources\nominated.png</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Remove="wwwroot/.DS_Store" />
    <None Remove="wwwroot/**/.DS_Store" />
    <Content Remove="wwwroot/.DS_Store" />
    <Content Remove="wwwroot/**/.DS_Store" />
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
